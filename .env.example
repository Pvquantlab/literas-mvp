# Supabase ayarları — supabase.com'dan al
# Bu dosyayı .env.local olarak kopyala ve gerçek değerleri yaz

# Sitenin genel adresi. Boş bırakılabilir:
#   - Vercel production  -> www.literaslab.com
#   - Vercel preview     -> dağıtımın kendi adresi (OG/sitemap doğru çıkar)
#   - yerel              -> http://localhost:3000
# Yalnızca farklı bir alan adı kullanıyorsan doldur.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyxxxxxxxxxx

# Resend — e-posta göndermek için
# resend.com'dan API anahtarı al
RESEND_API_KEY=re_xxxxxxxxxx

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cron güvenliği — /api/cron/reminders ucunu korur
# Rastgele üret: openssl rand -base64 32
#
# Bu değer ÜÇ yerde AYNI olmalı:
#   1) .env.local (yerel)
#   2) Vercel > Settings > Environment Variables (Sensitive)
#   3) Supabase > app_secrets tablosu, key='cron_secret'
#
# Örnek dosyaya ASLA gerçek değer yazma: bu satırda bir kez gerçek sır
# commit edildi ve repo herkese açık olduğu için o değer yakıldı, rotasyona
# sokuldu. Örnek dosya daima boş kalır.
CRON_SECRET=

# Sentry — canlıdaki hataları görmek için (yol haritası 1.5)
# sentry.io'da ücretsiz proje aç, "Client Keys (DSN)" bölümünden al.
#
# DSN BOŞSA SENTRY TAMAMEN SESSİZ. Yerelde ve preview dağıtımlarında boş
# bırakmak mantıklı: kotayı yalnızca gerçek canlı hatalar yesin.
NEXT_PUBLIC_SENTRY_DSN=

# Aşağıdakiler YALNIZCA kaynak haritası yüklemek için (opsiyonel).
# Olmazsa derleme yine geçer, sadece yığın izleri küçültülmüş görünür.
# Token'ı Vercel'e "Sensitive" olarak ekle; örnek dosyaya gerçek değer yazma.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
